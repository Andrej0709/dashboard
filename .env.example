# Copy this file to .env.local and fill in the two values from
# Supabase → Project Settings → API (or "Connect" → App Frameworks).
# The anon/publishable key is meant to be public; the database rules in supabase/migrations/ protect the data.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
